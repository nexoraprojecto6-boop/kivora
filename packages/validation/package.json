{
  "name": "@kivora/validation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Esquemas de validação reutilizáveis entre as aplicações KIVORA.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test \"dist/**/*.spec.js\""
  },
  "dependencies": {
    "@kivora/shared": "workspace:*",
    "zod": "^4.6.7"
  }
}
