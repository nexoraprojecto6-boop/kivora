# KIVORA — Exemplo de variáveis de ambiente.
#
# Este ficheiro tem apenas NOMES de variáveis e valores ilustrativos.
# NUNCA coloque aqui credenciais, chaves ou segredos reais.
# Para uso local, crie um ficheiro .env (ignorado pelo Git) e preencha-o lá.
#
# Os nomes são provisórios e serão confirmados quando o código existir.

# Ambiente: development, test ou production
NODE_ENV=development

# URLs das aplicações
API_PORT=3000
API_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5174

# CORS: origens permitidas, separadas por vírgulas
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Base de dados PostgreSQL (substituir UTILIZADOR, PALAVRA_PASSE e NOME_BD)
DATABASE_URL=postgresql://UTILIZADOR:PALAVRA_PASSE@localhost:5432/NOME_BD

# Sessões e cookies (o segredo fica vazio aqui; gerar um valor longo e aleatório no .env real)
SESSION_SECRET=
COOKIE_DOMAIN=localhost

# Armazenamento privado de documentos (fora de qualquer pasta pública)
PRIVATE_STORAGE_PATH=

# Operações financeiras reais: desactivadas por defeito.
# Só activar depois de validados o enquadramento jurídico, contratos e fornecedores.
FEATURE_FINANCIAL_OPERATIONS_ENABLED=false
